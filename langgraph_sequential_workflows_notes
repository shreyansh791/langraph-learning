### 2. Implementation: Multi-Node BMI Calculator (bmi_workflow.ipynb)
Demonstrates state creation, multiple node definitions, edge connections, compilation, invocation, and graph visualization:

```python
from typing import TypedDict
from langgraph.graph import StateGraph, START, END

# Step 1: Define State Schema
class BMIState(TypedDict):
    weight: float    # Weight in kilograms
    height: float    # Height in metres
    bmi: float       # Calculated BMI
    category: str    # Health category label

# Step 2: Implement Node Functions
def calculate_bmi(state: BMIState) -> BMIState:
    weight = state['weight']
    height = state['height']
    bmi_value = weight / (height ** 2)
    state['bmi'] = round(bmi_value, 2)
    return state

def label_bmi(state: BMIState) -> BMIState:
    bmi = state['bmi']
    if bmi < 18.5:
        state['category'] = "Underweight"
    elif 18.5 <= bmi < 25:
        state['category'] = "Normal"
    else:
        state['category'] = "Overweight"
    return state

# Step 3: Instantiate Graph & Register Nodes
graph = StateGraph(BMIState)
graph.add_node("calculate_bmi", calculate_bmi)
graph.add_node("label_bmi", label_bmi)

# Step 4: Add Sequential Edges
graph.add_edge(START, "calculate_bmi")
graph.add_edge("calculate_bmi", "label_bmi")
graph.add_edge("label_bmi", END)

# Step 5: Compile Graph
workflow = graph.compile()

# Step 6: Execute via Invocation
initial_state = {'weight': 80.0, 'height': 1.73}
final_state = workflow.invoke(initial_state)
print("Final State:", final_state)
# Output: {'weight': 80.0, 'height': 1.73, 'bmi': 26.73, 'category': 'Overweight'}
```

